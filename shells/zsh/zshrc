# ~/.zshrc — entrypoint (symlinked from shells/zsh/zshrc)
# Base configuration vendored from radleylewis/zsh lives in
# config/zsh/radleylewis/; local overrides go in shells/zsh/aliases.zsh
# or ~/.zshrc.local.

# =========================================================
# Environment
# =========================================================

export XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
export XDG_DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
export XDG_CACHE_HOME="${XDG_CACHE_HOME:-$HOME/.cache}"
export XDG_STATE_HOME="${XDG_STATE_HOME:-$HOME/.local/state}"

export EDITOR="nvim"
export VISUAL="nvim"

if command -v bat >/dev/null 2>&1; then
  export MANPAGER="bat -l man -p"
fi

if [ -d "$HOME/.local/bin" ]; then
  export PATH="$HOME/.local/bin:$PATH"
fi

# Resolve the repo root by following the ~/.zshrc symlink
# (shells/zsh/zshrc -> repo root is three levels up).
if [ -z "${DOTFILES_DIR:-}" ]; then
  _zshrc_real="$(readlink -f "${ZDOTDIR:-$HOME}/.zshrc" 2>/dev/null)"
  DOTFILES_DIR="${_zshrc_real:h:h:h}"
  unset _zshrc_real
fi

# =========================================================
# Base config (vendored from radleylewis/zsh, see config/zsh/radleylewis/)
# Order matters: bindings must run before plugins (zsh-vi-mode reads its
# ZVM_* settings at load time).
# =========================================================

RL_ZSH_DIR="$DOTFILES_DIR/config/zsh/radleylewis"
for _rl_module in core fzf aliases bindings plugins prompt; do
  [ -f "$RL_ZSH_DIR/${_rl_module}.zsh" ] && source "$RL_ZSH_DIR/${_rl_module}.zsh"
done
unset _rl_module

# =========================================================
# Version managers & dev environment
# =========================================================

if [ -f "$DOTFILES_DIR/config/zsh/dev.zsh" ]; then
  source "$DOTFILES_DIR/config/zsh/dev.zsh"
fi

# =========================================================
# WSL helpers (filesystem performance guard, interop aliases)
# =========================================================

if [ -f "$DOTFILES_DIR/config/zsh/wsl.zsh" ]; then
  source "$DOTFILES_DIR/config/zsh/wsl.zsh"
fi

# =========================================================
# Local overrides
# =========================================================

if [ -f "$DOTFILES_DIR/shells/zsh/aliases.zsh" ]; then
  source "$DOTFILES_DIR/shells/zsh/aliases.zsh"
fi

[[ -f ~/.zshrc.local ]] && source ~/.zshrc.local
